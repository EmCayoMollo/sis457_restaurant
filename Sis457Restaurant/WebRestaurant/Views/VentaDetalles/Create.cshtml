@model WebRestaurant.Models.VentaDetalle

@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Create</h1>

<h4>VentaDetalle</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="IdVenta" class="control-label"></label>
                <select asp-for="IdVenta" class ="form-control" asp-items="ViewBag.IdVenta"></select>
            </div>
            <div class="form-group">
                <label asp-for="IdPlatillo" class="control-label"></label>
                <select asp-for="IdPlatillo" class ="form-control" asp-items="ViewBag.IdPlatillo"></select>
            </div>
            <div class="form-group">
                <label asp-for="IdRefresco" class="control-label"></label>
                <select asp-for="IdRefresco" class ="form-control" asp-items="ViewBag.IdRefresco"></select>
            </div>
            <div class="form-group">
                <label asp-for="Cantidad" class="control-label"></label>
                <input asp-for="Cantidad" class="form-control" />
                <span asp-validation-for="Cantidad" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="TotalVentaDetalle" class="control-label"></label>
                <input asp-for="TotalVentaDetalle" class="form-control" />
                <span asp-validation-for="TotalVentaDetalle" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
